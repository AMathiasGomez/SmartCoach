# ================================
# SmartCoach - Variables de entorno
# ================================
# Copia este archivo como .env y completa los valores

# Base de datos (MySQL)
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=smartcoach
DB_TIMEZONE=-05:00

# Servicio de analytics (FastAPI / scikit-learn)
# Ejemplo Railway publico: https://smartcoach-analytics.up.railway.app
ANALYTICS_SERVICE_URL=
